# Copy this file to .env for local dev (optional — the server runs fine
# without Firebase configured, it just won't persist rooms/chat).

PORT=5000

# Firebase service account JSON, base64-encoded onto a single line.
# Get the JSON from: Firebase Console > Project Settings > Service Accounts
# > Generate new private key. Then encode it:
#   macOS/Linux: base64 -i serviceAccountKey.json | tr -d '\n'
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
# Paste the single resulting line below (or set it as an env var in your
# hosting provider's dashboard for deployment — do not commit the real value).
FIREBASE_SERVICE_ACCOUNT=